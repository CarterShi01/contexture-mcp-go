{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "revision", "specificationVersion", "status", "implementedRules"],
  "properties": {
    "$schema": { "type": "string" },
    "repository": { "type": "string", "format": "uri" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "specificationVersion": { "type": "string" },
    "status": { "enum": ["scaffold", "partial", "conformant"] },
    "implementedRules": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 16 },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  }
}
